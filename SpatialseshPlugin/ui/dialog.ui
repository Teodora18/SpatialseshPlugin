        <property name="text">
        <string>To use SpatialSesh plugin, enter your license key below, which you received via email. Your license will be checked online. A successful validation remains valid for 7 days.
Suppose you have any issues, please contact matt@maplango.com.</string>
        </property>
        <property name="wordWrap">
        <bool>true</bool>
        </property>
        <property name="styleSheet">
        <string>font-style: italic;</string>
        </property>
    </widget>
